{
  "about": "Demo data loaded into the empty database at startup by DemoDataSeeder (app.seed.enabled). Codes are written upper case, as the API stores them. Rule fields: environment and qualifier are codes of the same project; enabled defaults to true and priority to 0; effectiveFrom / effectiveTo are 'now', 'now+7d', 'now-3h' (days or hours relative to startup) or an ISO instant, or left out for no limit.",
  "projects": [
    {
      "name": "Storefront Web",
      "description": "Customer-facing online shop: catalogue, cart, checkout and campaigns for TR, DE and NL.",
      "environments": [
        { "code": "DEV", "name": "Development", "description": "Shared development cluster, deployed on every merge." },
        { "code": "QA", "name": "Quality Assurance", "description": "Manual and automated regression testing." },
        { "code": "STAGING", "name": "Staging", "description": "Production-like, used for release candidates and campaign previews." },
        { "code": "PROD", "name": "Production", "description": "Live shop at www.storefront.example." }
      ],
      "qualifiers": [
        { "code": "USER_ID", "name": "Customer ID", "valueType": "TEXT", "priority": 100, "description": "A single customer account, e.g. cust-10001. Used for internal testers and opt-outs." },
        { "code": "BETA_TESTER", "name": "Beta tester", "valueType": "BOOLEAN", "priority": 90, "description": "true for customers enrolled in the beta programme." },
        { "code": "CUSTOMER_TIER", "name": "Loyalty tier", "valueType": "TEXT", "priority": 70, "description": "STANDARD, SILVER, GOLD or PLATINUM." },
        { "code": "STORE_ID", "name": "Physical store", "valueType": "NUMERIC", "priority": 60, "description": "Store number for click & collect orders." },
        { "code": "COUNTRY", "name": "Country", "valueType": "TEXT", "priority": 50, "description": "Shipping country, ISO 3166 alpha-2 (TR, DE, NL)." },
        { "code": "AB_GROUP", "name": "A/B bucket", "valueType": "TEXT", "priority": 40, "description": "Experiment bucket A, B or C, assigned per visitor." },
        { "code": "DEVICE_TYPE", "name": "Device type", "valueType": "TEXT", "priority": 30, "description": "DESKTOP, MOBILE or TABLET." },
        { "code": "EXPERIMENT_CONTEXT", "name": "Experiment context", "valueType": "JSON", "priority": 10, "description": "JSON sent by the experimentation SDK, matched as a whole." }
      ],
      "features": [
        {
