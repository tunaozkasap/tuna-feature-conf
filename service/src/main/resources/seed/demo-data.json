            { "environment": "STAGING", "qualifier": "CUSTOMER_TIER", "qualifierValue": "GOLD", "featureValue": "true" },
            { "environment": "PROD", "qualifier": "USER_ID", "qualifierValue": "cust-10001", "featureValue": "true", "description": "Internal QA account" },
            { "environment": "PROD", "qualifier": "USER_ID", "qualifierValue": "cust-20417", "featureValue": "false", "priority": 10, "description": "Opted out after a payment issue (ticket SUP-4821)" },
